{
  "name": "dsh-mnemon-provider-supermemory",
  "version": "0.5.0-beta.1",
  "description": "Supermemory Provider child for the Memory Spaces Source.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./descriptor": {
      "types": "./lib/descriptor.d.ts",
      "default": "./lib/descriptor.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
