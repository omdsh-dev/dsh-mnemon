    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "dsh-mnemon-source-memory-spaces": "0.5.0-beta.1",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "tsdown": "^0.22.0",
    "vitest": "^3.2.0",
    "dsh-mnemon-source-memory-spaces": "0.5.0-beta.1"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
