{
  "name": "dsh-mnemon-source-runtime",
  "version": "0.3.5",
  "description": "Self-contained runtime Source for Composable View Memory.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "dsh-mnemon": "^0.3.5",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "dsh-mnemon": "^0.3.5",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "tsdown": "^0.22.0",
    "vitest": "^3.2.0"
  }
}
