{
  "name": "dsh-mnemon-source-memory-spaces",
  "version": "0.4.0",
  "description": "Memory Spaces Source and its private Provider SDK.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./provider-sdk": {
      "types": "./lib/provider-sdk.d.ts",
      "default": "./lib/provider-sdk.js"
    },
    "./package.json": "./package.json",
    "./testing": {
      "types": "./lib/testing.d.ts",
      "default": "./lib/testing.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown && tsc -p tsconfig.client-types.json",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "dsh-mnemon": "^0.4.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "dsh-mnemon": "^0.4.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "tsdown": "^0.22.0",
    "vitest": "^3.2.0",
    "react": "^18.2.0",
    "@types/react": "^18.3.0",
    "react-dom": "^18.2.0",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^26.0.0",
    "@testing-library/react": "^16.3.0",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "client": {
      "inject": [
        "slots"
      ],
      "platform": "web"
    }
  }
}
