    "@types/react-dom": "^18.3.0",
    "@testing-library/react": "^16.3.0",
    "jsdom": "^26.0.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.1",
