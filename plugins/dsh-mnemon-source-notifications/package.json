{
  "name": "dsh-mnemon-source-notifications",
  "version": "0.1.0",
  "description": "A local notification inbox, registered attachments and reviewed channel delivery.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown && tsc -p tsconfig.client-types.json",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "dsh-mnemon": "^0.5.5",
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1",
