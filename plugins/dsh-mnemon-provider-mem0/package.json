  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "tsdown": "^0.22.0",
    "vitest": "^3.2.0",
    "dsh-mnemon-source-memory-spaces": "^0.4.0"
  }
}
