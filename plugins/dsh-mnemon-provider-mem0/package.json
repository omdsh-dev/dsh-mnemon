{
  "name": "dsh-mnemon-provider-mem0",
  "version": "0.4.0",
  "description": "Mem0 Provider child for the Memory Spaces Source.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
