    "source": "RetainDB/RetainDB 2ad2cc4d (Apache-2.0), read from a clean checkout and on GitHub",
    "server": {
      "requestSchema": {
        "POST /v1/memory": "https://github.com/RetainDB/RetainDB/blob/2ad2cc4d6d58145eca1a6cbbce66dfc5b5380f38/packages/server/src/api/memory.ts#L932: importance z.number().min(0).max(1).optional().default(0.5)",
        "POST /v1/memories": "https://github.com/RetainDB/RetainDB/blob/2ad2cc4d6d58145eca1a6cbbce66dfc5b5380f38/packages/server/src/api/routes.ts#L2588: the same",
        "validator": "@hono/zod-validator 0.4.3 (packages/server/package.json ^0.4.0, pnpm-lock.yaml) answers a failed parse with c.json(result, 400); zod ^3.24.0 (3.25.76)"
      },
      "defaults": {
        "database": "https://github.com/RetainDB/RetainDB/blob/2ad2cc4d6d58145eca1a6cbbce66dfc5b5380f38/packages/server/prisma/schema.prisma#L230: importance Float @default(0.5)",
        "writePath": "https://github.com/RetainDB/RetainDB/blob/2ad2cc4d6d58145eca1a6cbbce66dfc5b5380f38/packages/server/src/engine/memory/write.ts#L707: importance: input.importance ?? 0.5"
      },
      "registry": "https://github.com/RetainDB/RetainDB/blob/2ad2cc4d6d58145eca1a6cbbce66dfc5b5380f38/packages/server/src/contracts/registry.mjs#L351: \"importance must be between 0 and 1 when provided.\""
    },
    "local": {
      "package": "@retaindb/local 0.2.2",
      "stored": "https://github.com/RetainDB/RetainDB/blob/2ad2cc4d6d58145eca1a6cbbce66dfc5b5380f38/packages/local/src/cli.ts#L728: clamp((input.importance ?? 0.62) + quality * 0.28 + (MEMORY_TYPE_WEIGHT[type] || 0.3) * 0.12, 0.1, 0.99)",
      "recall": "https://github.com/RetainDB/RetainDB/blob/2ad2cc4d6d58145eca1a6cbbce66dfc5b5380f38/packages/local/src/cli.ts#L904: each recall score adds the memory's importance",
      "consequence": "any importance of 1 or more is stored at 0.99"
    },
    "retainDbWriters": {
      "sdkExtraction": "https://github.com/RetainDB/RetainDB/blob/2ad2cc4d6d58145eca1a6cbbce66dfc5b5380f38/packages/sdk/src/whisper-agent.ts#L284: importance: Math.max(0.5, Math.min(1, m.confidence || 0.7))",
      "localSessionWrites": "https://github.com/RetainDB/RetainDB/blob/2ad2cc4d6d58145eca1a6cbbce66dfc5b5380f38/packages/local/src/cli.ts#L804: 0.75 for user messages, 0.55 otherwise",
      "localHandoffWrites": "https://github.com/RetainDB/RetainDB/blob/2ad2cc4d6d58145eca1a6cbbce66dfc5b5380f38/packages/local/src/cli.ts#L1838: 0.92 for handoffs and decisions, 0.72 otherwise",
      "band": "about 0.5 to 0.9"
    },
    "otherClients": {
      "hermesAgent": "https://github.com/NousResearch/hermes-agent/blob/419e6627aaeda9c87e0b17bcc013484a2bfdb194/plugins/memory/retaindb/__init__.py#L148: add_memory(..., importance: float = 0.7); also sends 0.7 by default"
    }
  },
  "memorySpacesSource": {
    "prepareRemember": "plugins/dsh-mnemon-source-memory-spaces/src/service.ts: importance = integer(request.importance, 3, 1, 5), for remember and rememberMany",
    "integer": "src/sdk/input.ts: an absent value becomes the fallback 3; anything but an integer within 1..5 is refused"
  },
  "mapping": {
    "rule": "level = round(importance) clamped to 1..5, as the Holographic Provider reads it (#459); no importance, or one that is not a finite number: 0.7; otherwise 0.7 + (level - 3) * 0.1, rounded to 2 decimals",
    "importance 1..5": [
      0.5,
      0.6,
      0.7,
      0.8,
      0.9
    ],
    "no importance, NaN or infinity": 0.7,
    "examples": {
      "9": 0.9,
      "-9": 0.5,
      "2.4": 0.6,
      "3.6": 0.8
    },
    "band": "0.5..0.9, the band RetainDB's own writers use",
    "legacyFallback": "POST /v1/memories carries the same importance: it is the same body without write_mode",
    "readBack": "search and list read id, content, score or similarity, memory_type or category, and created_at; no importance is read back, so nothing maps back",
    "existingMemories": "not rewritten; on RetainDB Local they keep the stored 0.99, which recall still adds to their scores"
  },
