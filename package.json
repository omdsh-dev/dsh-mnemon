{
  "name": "dsh-mnemon",
  "version": "0.5.0",
  "description": "Composable three-tier memory control plane for DeepSeek Harness: persistent runtime context, searchable project documents, pluggable long-term memory, guarded strategies, WebUI, and headless tools.",
  "keywords": [
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh-plugin",
    "agent-memory",
    "llm-memory",
    "persistent-memory",
    "long-term-memory",
    "runtime-memory",
    "working-memory",
    "cross-session-memory",
    "multi-agent-memory",
    "shared-agent-memory",
    "memory-orchestration",
    "memory-provider",
    "pluggable-memory",
    "context-management",
    "project-memory",
    "project-documents",
    "document-search",
    "semantic-recall",
    "local-first",
    "mnemon",
    "openviking",
    "honcho",
    "mem0",
    "hindsight",
    "holographic-memory",
    "retaindb",
    "byterover",
    "supermemory"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omdsh-dev/dsh-mnemon.git"
  },
  "homepage": "https://github.com/omdsh-dev/dsh-mnemon#readme",
  "bugs": {
    "url": "https://github.com/omdsh-dev/dsh-mnemon/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "contracts": [
        "lib/types/src/core/contracts/index.d.ts"
      ],
      "extension-sdk": [
        "lib/types/src/sdk/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/src/index.d.ts",
      "default": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/types/src/core/plugin.d.ts",
      "default": "./lib/core.js"
    },
    "./client": {
      "types": "./lib/types/src/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./contracts": {
      "types": "./lib/types/src/core/contracts/index.d.ts",
      "default": "./lib/contracts.js"
    },
    "./extension-sdk": {
      "types": "./lib/types/src/sdk/index.d.ts",
      "default": "./lib/extension-sdk.js"
    },
    "./testing": {
      "types": "./lib/types/src/sdk/testing.d.ts",
      "default": "./lib/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.types.json && node scripts/link-bundle-declarations.mjs",
    "bundle": "tsdown",
    "prepublishOnly": "pnpm run verify",
    "lint:package": "publint --strict && attw --pack . --profile esm-only --quiet",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify:build": "node scripts/verify-deterministic-build.mjs",
    "verify:headless": "node scripts/verify-headless-profile.mjs",
    "verify:package": "node scripts/verify-package-contents.mjs && node scripts/verify-public-entries.mjs && pnpm run lint:package",
    "verify:plugins": "node scripts/verify-plugin-artifacts.mjs",
    "e2e:serve": "node scripts/serve-e2e.mjs",
    "verify": "pnpm run typecheck && pnpm run verify:build && pnpm --workspace-concurrency=1 -r build && pnpm -r typecheck && pnpm -r test && pnpm run test && pnpm run verify:headless && pnpm run verify:package",
    "dsh:link-source": "node scripts/link-dsh-source.mjs",
    "dsh:restore-registry": "node scripts/link-dsh-source.mjs --restore",
    "release:check": "node scripts/release.mjs --check"
  },
  "dependencies": {
    "dsh-mnemon-provider-byterover": "0.5.0",
    "dsh-mnemon-provider-hindsight": "0.5.0",
    "dsh-mnemon-provider-holographic": "0.5.0",
    "dsh-mnemon-provider-honcho": "0.5.0",
    "dsh-mnemon-provider-mem0": "0.5.0",
    "dsh-mnemon-provider-mnemon-native": "0.5.0",
    "dsh-mnemon-provider-openviking": "0.5.0",
    "dsh-mnemon-provider-retaindb": "0.5.0",
    "dsh-mnemon-provider-supermemory": "0.5.0",
    "dsh-mnemon-source-documents": "0.5.0",
    "dsh-mnemon-source-memory-spaces": "0.5.0",
    "dsh-mnemon-source-runtime": "0.5.0",
    "dsh-mnemon-strategy-auto-capture": "0.5.0",
    "dsh-mnemon-strategy-default-three-tier": "0.5.0",
    "dsh-mnemon-strategy-light-context": "0.5.0",
    "dsh-mnemon-strategy-scoped": "0.5.0",
    "fflate": "^0.8.3",
    "schemastery": "^3.18.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6 || ^0.1.1-rc.1 || ^0.1.2-alpha.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh": "0.1.2-rc.1",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-agent-loop": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-store": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-tool": "0.1.2-rc.1",
    "@deepseek-ai/dsh-invariants": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-projection-legacy": "npm:@deepseek-ai/dsh-session-projection@0.1.0-rc.8",
    "@deepseek-ai/dsh-session-query": "0.1.2-rc.1",
    "@deepseek-ai/dsh-subagent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^26.1.0",
    "lightningcss": "^1.29.0",
    "publint": "^0.3.23",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
